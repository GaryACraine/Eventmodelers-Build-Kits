{
    "compilerOptions": {
        "forceConsistentCasingInFileNames": true,
        "module": "NodeNext",
        "target": "ESNext",
        "moduleResolution": "NodeNext",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,
        "strict": true,
        "skipLibCheck": true,
        "outDir": "./dist",
        "noEmit": true
    },
    "include": ["./src/**/*"],
    "exclude": ["node_modules", "dist"]
}
