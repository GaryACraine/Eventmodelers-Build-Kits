# Where the backend runs. Empty = same origin (a proxy, or the backend serving web/dist).
VITE_API_BASE=http://localhost:3000
# live = call the backend; mock = serve every request from src/mocks/handlers.ts (the scenario examples).
# `npm run dev:mock` sets mock for you (see .env.mock).
VITE_DATA_MODE=live
# Rows per page of a list before "Load more" (default 20). A small value shows paging on a small dataset.
# VITE_PAGE_SIZE=20
# Sign-in: better-auth = real sign-in through the sign-in service (`npm run infra:start` runs it; Vite proxies
# /api/auth to it), once the project's Sign Up screen is built. Unset or stub = the session stub asks for the IDs.
# VITE_SIGN_IN=better-auth
