PG_CONNECTION_STRING=postgresql://dcb:dcb@localhost:5432/dcb
PORT=3000
# Origins allowed to call the API from a browser (the web/ app): comma-separated, or *. Unset = same origin only.
CORS_ORIGIN=http://localhost:5173
# Sign-in (ADR-055): who issues the bearer tokens the API accepts, and where this service fetches its JWKS. The issuer
# is the sign-in service's BETTER_AUTH_URL (the web app's origin); the audience defaults to it. Unset = every token is
# refused (requests without one still pass until routes require sign-in).
AUTH_ISSUER=http://localhost:5173
AUTH_JWKS_URL=http://localhost:3001/api/auth/jwks
